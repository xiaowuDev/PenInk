<Window x:Class="PenInk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PenInk 手写批注"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#F0182433"/>
            <Setter Property="BorderBrush" Value="#3D536D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Width" Value="21"/>
            <Setter Property="Height" Value="21"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#E7EEF8"/>
            <Setter Property="Background" Value="#101B2633"/>
            <Setter Property="BorderBrush" Value="#24425973"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#263548"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#4A75A9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#8BC5FF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Chrome" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#8BC5FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.36"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorButton" TargetType="Button">
            <Setter Property="Width" Value="19"/>
            <Setter Property="Height" Value="19"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderBrush" Value="#00000000"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="{TemplateBinding BorderThickness}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#BFD8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderRepeatButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WidthSliderStyle" TargetType="Slider">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="112"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Width="5"
                                    HorizontalAlignment="Center"
                                    CornerRadius="3"
                                    Background="#314258"/>
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Style="{StaticResource SliderRepeatButton}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="20" Height="20">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="#F8FBFF"
                                                             Stroke="#2F80ED"
                                                             StrokeThickness="2"/>
                                                    <Ellipse Width="6"
                                                             Height="6"
                                                             Fill="#2F80ED"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Style="{StaticResource SliderRepeatButton}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="#01000000">
        <InkCanvas x:Name="Ink"
                   Background="#01000000"
                   EditingMode="Ink"
                   UseCustomCursor="False"
                   StrokeCollected="Ink_StrokeCollected"
                   PreviewMouseLeftButtonDown="Ink_PreviewMouseLeftButtonDown"
                   PreviewMouseLeftButtonUp="Ink_PreviewMouseLeftButtonUp"
                   PreviewStylusDown="Ink_PreviewStylusDown"
                   PreviewStylusUp="Ink_PreviewStylusUp"/>

        <Border x:Name="Toolbar"
                Width="58"
                Padding="7,9"
                Margin="0,0,24,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="#EF141C28"
                BorderBrush="#384F68"
                BorderThickness="1"
                CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22"
                                  Direction="270"
                                  Opacity="0.42"
                                  ShadowDepth="5"
                                  Color="#000000"/>
            </Border.Effect>

            <StackPanel HorizontalAlignment="Center">
                <Border Width="22"
                        Height="3"
                        Margin="0,0,0,7"
                        Background="#516174"
                        CornerRadius="2"/>

                <Button x:Name="PenButton"
                        Style="{StaticResource IconButton}"
                        Click="Pen_Click"
                        ToolTip="画笔  Ctrl+Alt+P">
                    <Path Style="{StaticResource IconPath}"
                          Data="M4,19 L8,18 L18,8 L15,5 L5,15 Z M13.5,6.5 L16.5,9.5"/>
                </Button>

                <Button x:Name="EraserButton"
                        Style="{StaticResource IconButton}"
                        Click="Eraser_Click"
                        ToolTip="橡皮  Ctrl+Alt+E">
                    <Path Style="{StaticResource IconPath}"
                          Data="M5,16 L13,8 L20,15 L15,20 H9 Z M10,19 L6,15"/>
                </Button>

                <Button x:Name="UndoButton"
                        Style="{StaticResource IconButton}"
                        Click="Undo_Click"
                        ToolTip="撤销  Ctrl+Alt+Z">
                    <Path Style="{StaticResource IconPath}"
                          Data="M8,8 H4 V4 M4,8 C6.5,4.5 12.5,4 16.5,7.5 C20.5,11 19,18 14,19.5 C10.5,20.5 7.5,19.5 5.5,17"/>
                </Button>

                <Button Style="{StaticResource IconButton}"
                        Click="Clear_Click"
                        ToolTip="清屏  Ctrl+Alt+Backspace">
                    <Path Style="{StaticResource IconPath}"
                          Data="M6,7 H18 M9,7 V5 H15 V7 M8,10 V19 M12,10 V19 M16,10 V19 M7,7 L8,21 H16 L17,7"/>
                </Button>

                <Border Height="1"
                        Width="34"
                        Margin="0,8"
                        Background="#334258"/>

                <Grid Width="32"
                      Height="32"
                      Margin="0,0,0,4"
                      ToolTip="当前颜色">
                    <Ellipse Stroke="#EAF2FF"
                             StrokeThickness="2"/>
                    <Ellipse x:Name="CurrentColorDot"
                             Margin="5"
                             Fill="#FF3030"/>
                </Grid>

                <UniformGrid Columns="2"
                             Rows="3"
                             Width="46"
                             HorizontalAlignment="Center">
                    <Button x:Name="RedColorButton" Style="{StaticResource ColorButton}" Background="#FF3030" BorderBrush="#EAF2FF" Click="Color_Click" Tag="#FF3030" ToolTip="红色"/>
                    <Button Style="{StaticResource ColorButton}" Background="#FFE100" Click="Color_Click" Tag="#FFE100" ToolTip="黄色"/>
                    <Button Style="{StaticResource ColorButton}" Background="#2684FF" Click="Color_Click" Tag="#2684FF" ToolTip="蓝色"/>
                    <Button Style="{StaticResource ColorButton}" Background="#25B46B" Click="Color_Click" Tag="#25B46B" ToolTip="绿色"/>
                    <Button Style="{StaticResource ColorButton}" Background="#FFFFFF" Click="Color_Click" Tag="#FFFFFF" ToolTip="白色"/>
                    <Button Style="{StaticResource ColorButton}" Background="#111827" Click="Color_Click" Tag="#111827" ToolTip="黑色"/>
                </UniformGrid>

                <Border Height="1"
                        Width="34"
                        Margin="0,8"
                        Background="#334258"/>

                <Slider x:Name="WidthSlider"
                        Style="{StaticResource WidthSliderStyle}"
                        Minimum="1.5"
                        Maximum="24"
                        Value="4"
                        Orientation="Vertical"
                        IsSnapToTickEnabled="False"
                        ValueChanged="WidthSlider_ValueChanged"
                        ToolTip="粗细"/>

                <Border Height="1"
                        Width="34"
                        Margin="0,8"
                        Background="#334258"/>

                <Button Style="{StaticResource IconButton}"
                        Click="Mouse_Click"
                        ToolTip="鼠标穿透  Ctrl+Alt+M">
                    <Path Style="{StaticResource IconPath}"
                          Data="M5,3 L18,14 L12,15 L15,21 L12,22 L9,16 L5,20 Z"/>
                </Button>

                <Button Style="{StaticResource IconButton}"
                        Click="Hide_Click"
                        ToolTip="隐藏  Esc / Ctrl+Alt+H">
                    <Path Style="{StaticResource IconPath}"
                          Data="M3,12 C5.5,7.5 8.5,5.5 12,5.5 C15.5,5.5 18.5,7.5 21,12 C18.5,16.5 15.5,18.5 12,18.5 C8.5,18.5 5.5,16.5 3,12 Z M9.5,12 C9.5,10.6 10.6,9.5 12,9.5 C13.4,9.5 14.5,10.6 14.5,12 C14.5,13.4 13.4,14.5 12,14.5 C10.6,14.5 9.5,13.4 9.5,12 Z"/>
                </Button>

                <Button Style="{StaticResource IconButton}"
                        Click="Exit_Click"
                        ToolTip="退出">
                    <Path Style="{StaticResource IconPath}"
                          Data="M7,7 L17,17 M17,7 L7,17"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
